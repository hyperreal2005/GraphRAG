GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_WORKERS=2

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
# Configure separate read credentials outside single-user Community deployments.
NEO4J_QUERY_USER=neo4j
NEO4J_QUERY_PASSWORD=replace-with-a-strong-local-password

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

COHERE_API_KEY=
QUERY_RERANK_ENABLED=true
QUERY_GRAPH_DYNAMIC_ENABLED=false
QUERY_GRAPH_TRANSACTION_TIMEOUT_SECONDS=5
