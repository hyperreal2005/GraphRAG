GEMINI_API_KEY=
# Query-time model: analysis, answers, LLM reranking. Safe to change for experiments.
GEMINI_MODEL=gemini-3.5-flash-lite
# Build-time model: extraction, merge adjudication, community summaries. Part of the
# pipeline fingerprint - changing it re-extracts the corpus on the next ingest.
INGESTION_MODEL=gemini-3.8-flash
GEMINI_MAX_WORKERS=2
EXTRACTION_PROMPT_VERSION=assertion-r2-v1
INGESTION_PROVIDER_TIMEOUT_SECONDS=120
INGESTION_PROGRESS_INTERVAL_CHUNKS=5
GRAPH_EXCLUDE_REFERENCE_SECTIONS=true

# gemini-embedding-001, not -2: -2 sheds load server-side regardless of billing tier
# (failed at 0.6% of a 5,000 RPM limit). Changing the model re-bases the vector space -
# re-embed with scripts/reembed_corpus.py, and recalibrate ENTITY_LINK_RESOLVE_THRESHOLD.
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIM=3072
EMBEDDING_VERSION=embedding001-3072-r4
EMBEDDING_PROMPT_VERSION=embedding001-tasktype-v1
# Behaviour is chosen by capability, not by matching the model name. -001 takes a native
# task_type and no text prefix; -2 took the opposite convention.
EMBEDDING_MODEL_SUPPORTS_TASK_TYPE=true
EMBEDDING_MODEL_USES_INSTRUCTION_PREFIX=false
EMBEDDING_PROBE_ON_STARTUP=true
EMBEDDING_NORMALIZATION_POLICY=provider-default
OUTBOX_LEASE_SECONDS=60
# Hours a mid-build document version may sit before the orphan sweeper retracts its
# staged rows. An active version is never swept, whatever its age.
OUTBOX_ORPHAN_SWEEP_HOURS=24
# Share of a document chunks that may fail extraction and be quarantined before the
# whole document is failed. Above this the failure is treated as systemic.
EXTRACTION_CHUNK_FAILURE_RATIO=0.05
# 0 = one chunk per table row (the corpus of record, wp24, and wp2f before it). Part of the
# pipeline fingerprint: ingesting into a corpus chunked otherwise rebuilds it. wp2g used 700.
CHUNK_TABLE_BLOCK_TARGET_TOKENS=0
# Gate 18: extract consecutive table rows in one call, up to this many tokens of rows, while
# chunks stay one per row and every fact stays filed under its own row. 0 = one call per row.
# Part of the fingerprint when on (REFACTOR3 WP24).
EXTRACTION_TABLE_BATCH_TOKENS=600
EXTRACTION_TABLE_BATCH_MAX_ROWS=30
# Coreference annotation of the text extraction reads ("it [Rusnano]"); stored chunks are
# never rewritten. Part of the fingerprint when on: enabling it re-ingests a corpus built
# without it, re-extracting only the chunks whose annotated text differs (REFACTOR3 WP20).
COREF_ENABLED=false
QUERY_ANALYSIS_TIMEOUT_SECONDS=15
QUERY_ENTITY_LINK_TIMEOUT_SECONDS=20
QUERY_GRAPH_TIMEOUT_SECONDS=15
QUERY_VECTOR_TIMEOUT_SECONDS=15
QUERY_RERANK_TIMEOUT_SECONDS=15
QUERY_GENERATION_TIMEOUT_SECONDS=45
# Per embedding model - recalibrate whenever EMBEDDING_MODEL_ID changes. 0.72 for
# gemini-embedding-001 (absent names top out at 0.711, real matches bottom at 0.724).
# 0.75 was the -2 value; on -001 it drops 12 of 57 real entities and graph retrieval
# goes silent. The margin is 0 on purpose: a technical corpus is full of legitimate
# near-neighbours, so a top-2 gap requirement suppresses correct answers.
ENTITY_LINK_RESOLVE_THRESHOLD=0.72
ENTITY_LINK_RESOLVE_MARGIN=0.00
ENTITY_LINK_CANDIDATE_K=5
ENTITY_LINK_MENTION_WEIGHT=0.60
ENFORCE_EMBEDDING_METADATA=true
GRAPH_SCHEMA_VERSION=5
QUERY_INCLUDE_REFERENCE_CHUNKS=false
# WP6 hybrid retrieval, computed locally (no provider call). OFF by default: measured
# on 2026-08-27 against the judged set with corpus and questions held fixed, it moved
# recall@10 from 0.653 to 0.612 and MRR from 0.463 to 0.449, so the gate was not met.
# Turning it on for an index built without it degrades to dense-only until the chunks
# collection is recreated.
QUERY_SPARSE_ENABLED=false
QUERY_RRF_K=60

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
# Configure separate read credentials outside single-user Community deployments.
#
# Neo4j Community has no role-based access control: every authenticated user holds
# implied administrator privileges, so these credentials are NOT a read-only boundary
# however they are named. The query plane's only real containment is the application-owned
# template allowlist in `retrieval/dynamic_cypher.py`, which is why dynamic Cypher is
# generated into a fixed set of parameterised shapes rather than executed as free text.
# A genuine read-only role requires Neo4j Enterprise (`GRANT ROLE reader`) or an external
# proxy. Treat NEO4J_QUERY_USER as separation of concerns, not as a security control.
NEO4J_QUERY_USER=neo4j
NEO4J_QUERY_PASSWORD=replace-with-a-strong-local-password

# Neo4j, the graph store (docker-compose.yml). The compose file will not start without a
# password; the pipeline reads the same value.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# The corpus every CLI uses when no --db / --metadata-db is passed: its SQLite store and its
# three Qdrant collections, which must belong together. Leave all four unset for a fresh
# deployment (data/metadata.db, chunks, entities, communities). This repo's corpus of record:
# METADATA_DB_PATH=data/refactor3_wp25/metadata.db
# QDRANT_CHUNKS_COLLECTION=chunks_wp25
# QDRANT_ENTITIES_COLLECTION=entities_wp25
# QDRANT_COMMUNITIES_COLLECTION=communities_wp25

# Query cache and session chains (ROADMAP D2): the redis service in docker-compose.yml.
# Without it, an in-process cache stands in and nothing fails.
REDIS_URL=redis://127.0.0.1:6380/0

# The API (python main_api.py) listens on 127.0.0.1 unless a token is set. With one, it may
# bind elsewhere and every request must carry "Authorization: Bearer <token>".
API_TOKEN=

COHERE_API_KEY=
QUERY_RERANK_ENABLED=true
# Measured best on this corpus (REFACTOR3 WP17, WP19). Without a key, reranking degrades to
# rank-fusion order and every report's rerank_modes histogram says so.
QUERY_RERANK_MODEL=rerank-v4.0-pro
# A Cohere trial key is limited per minute. 6.5 s paces calls under that limit, so a
# judged run is not silently degraded by 429s. Leave at 0 for a production key.
QUERY_RERANK_MIN_INTERVAL_SECONDS=0
QUERY_GRAPH_DYNAMIC_ENABLED=false
QUERY_GRAPH_TRANSACTION_TIMEOUT_SECONDS=5

# WP1 evaluation harness
EVAL_JUDGE_MODEL=gemini-3.5-flash-lite
EVAL_JUDGE_PROMPT_VERSION=judge-r2-v1
